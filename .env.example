# Copy this file to ".env" in this folder and fill in your own password.
# The .env file is in .gitignore: it is never uploaded to GitHub.

# The MoodPulse database. "postgres" is the user made when PostgreSQL was installed,
# YOUR_PASSWORD is the password you chose then, 5432 is PostgreSQL's standard port.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/moodpulse

# A second, separate database for the tests (the tests empty it). Optional.
TEST_DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/moodpulse_test

# The AI model for the wellbeing advisor (optional).
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:3b
# Secret key used to sign Flask authentication session cookies.
# Replace this with a long, randomly generated secret in your local .env file.
FLASK_SECRET_KEY=REPLACE_WITH_YOUR_OWN_RANDOM_SECRET